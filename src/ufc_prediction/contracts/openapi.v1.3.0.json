        "required": [
          "odds_source",
          "fighter_a_n_ufc_fights",
          "fighter_b_n_ufc_fights",
          "is_debutant_either"
        ],
        "title": "PredictionMetadataV12",
        "description": "CONTRACT-V24-02: additive v1.2.0 prediction_metadata block.\n\nSix partner-facing observability fields. Forward-compat: defaults to\nNone on PredictorOutputV1, so v1.0.0 + v1.1.0 partners see this field\nabsent / null (Phase 25 forward-compat lock)."
      },
      "PredictorOutputV1": {
        "properties": {
